# =============================================================================
# SECRETS TEMPLATE - DO NOT COMMIT WITH REAL VALUES
# =============================================================================
# Usage:
# 1. Copy this file to secrets.yaml
# 2. Replace placeholders with base64-encoded values:
#    echo -n "your-value" | base64
# 3. Apply: kubectl apply -f k8s/secrets.yaml
# 4. DO NOT commit secrets.yaml to git

apiVersion: v1
kind: Secret
metadata:
  name: mlops-secrets
  namespace: mlops
type: Opaque
data:
  # AWS Bedrock (for LLM and Embeddings)
  AWS_ACCESS_KEY_ID: <BASE64_ENCODED_VALUE>
  AWS_SECRET_ACCESS_KEY: <BASE64_ENCODED_VALUE>
  AWS_REGION: dXMtZWFzdC0x  # us-east-1

  # DagsHub MLflow
  DAGSHUB_USERNAME: <BASE64_ENCODED_VALUE>
  DAGSHUB_TOKEN: <BASE64_ENCODED_VALUE>
  MLFLOW_TRACKING_USERNAME: <BASE64_ENCODED_VALUE>
  MLFLOW_TRACKING_PASSWORD: <BASE64_ENCODED_VALUE>

  # Finnhub API (for news)
  FINNHUB_API_KEY: <BASE64_ENCODED_VALUE>
